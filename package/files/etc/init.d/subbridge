#!/bin/sh /etc/rc.common
# SubBridge procd service.
#
# The daemon has no scheduled work. It exists so the LuCI page can start, stop
# and restart a real system service; checks are always started explicitly.

START=95
STOP=10
USE_PROCD=1

start_service() {
	# The UCI flag is the package master switch. The rc.d symlink is managed
	# by enable/disable; this guard also covers a manually started service.
	[ "$(uci -q get subbridge.main.enabled)" = "0" ] && return 0

	procd_open_instance
	procd_set_param command /usr/bin/subbridge daemon
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# A check runs inside the daemon process; when procd terminates it the
	# temporary engine may survive for a moment. Remove it and the lock so the
	# next start is clean.
	pgrep -f '[s]ing-box run -c /tmp/subbridge-check-' 2>/dev/null |
		while read -r pid; do kill -TERM "$pid" 2>/dev/null; done
	pgrep -f '[s]ing-box check -c /tmp/subbridge-probe-' 2>/dev/null |
		while read -r pid; do kill -TERM "$pid" 2>/dev/null; done

	rmdir /tmp/subbridge-check.lock 2>/dev/null

	return 0
}
